<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="project_project_view_form_inherit_project_improve" model="ir.ui.view">
        <field name="name">project.project.form.inherit.project_improve</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]" position="attributes">
                <attribute name="class" add="pe-0" separator=" "/>
                <attribute name="style">max-width: initial;</attribute>
            </xpath>
            <xpath expr="//div[hasclass('oe_title')]/h1" position="replace">
                <h1 class="d-flex justify-content-between align-items-center">
                    <div class="d-flex w-100">
                        <field name="is_favorite" nolabel="1" widget="boolean_favorite" class="me-2"/>
                        <field name="name" options="{'line_breaks': False}" widget="text" class="o_text_overflow" placeholder="e.g. Office Party"/>
                    </div>
                    <div class="d-flex justify-content-end o_state_container">
                        <field name="state" widget="project_planning_state_selection"
                               options="{'hide_label': False}"/>
                    </div>
                </h1>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Equipo asignado" name="candidate_team">
                    <group>
                        <field name="resource_priority"/>
                        <field name="candidate_user_ids" widget="many2many_tags"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>

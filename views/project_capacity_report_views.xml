<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="project_capacity_report_wizard_form" model="ir.ui.view">
        <field name="name">project.capacity.report.wizard.form</field>
        <field name="model">project.capacity.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Capacidad agregada por skill">
                <group>
                    <field name="horizon_weeks"/>
                </group>
                <field name="line_ids">
                    <tree editable="false" create="false" delete="false">
                        <field name="skill_id"/>
                        <field name="committed_hours"/>
                        <field name="available_hours"/>
                        <field name="gap_hours" decoration-danger="gap_hours &lt; 0"/>
                    </tree>
                </field>
                <footer>
                    <button string="Calcular" name="action_compute"
                            type="object" class="btn-primary"/>
                    <button string="Publicar como reporte" name="action_publish"
                            type="object" class="btn-secondary"
                            invisible="not line_ids"/>
                    <button string="Cerrar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_project_capacity_report_wizard" model="ir.actions.act_window">
        <field name="name">Capacidad agregada por skill</field>
        <field name="res_model">project.capacity.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_project_capacity_report"
              name="Capacidad agregada por skill"
              parent="project.menu_project_report"
              action="action_project_capacity_report_wizard"
              groups="project.group_project_manager"
              sequence="100"/>
</odoo>
